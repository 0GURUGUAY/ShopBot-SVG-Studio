{
  "name": "shopbot-svg-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:windows": "npm run build && node scripts/build-windows.cjs",
    "desktop": "electron .",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.shopbotsvgstudio.app",
    "productName": "ShopBot SVG Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg-path-parser": "^1.1.0"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/svg-path-parser": "^1.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
